NODE_ENV=development
PORT=5000
TRUST_PROXY=false

# Pisahkan beberapa origin dengan koma.
FRONTEND_ORIGINS=http://localhost:5173

# Gunakan "smtp" untuk Gmail asli dan "json" hanya untuk pengujian lokal.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=legalpro.notification@gmail.com
SMTP_PASS=masukkan_app_password_tanpa_spasi
VERIFY_SMTP_ON_STARTUP=true

MAIL_FROM_NAME=LegalPro Notifikasi
MAIL_TO=admin@example.com
MAIL_CC=

# Semua ukuran menggunakan MB.
MAX_FILE_SIZE_MB=5
MAX_TOTAL_UPLOAD_MB=15
MAX_DOCUMENT_FILES=25
MAX_TEXT_FIELD_MB=1

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=10
IDEMPOTENCY_TTL_MINUTES=30

# Opsional. Jika kosong, sistem memakai folder temporary OS.
UPLOAD_TMP_DIR=
